TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_NUMBER=+1XXXXXXXXXX

FORWARD_TO=+54911XXXXXXXX

# scheme://host only: no trailing slash, no path. The app is mounted at the root,
# and every Twilio callback and signature check is derived from this value.
PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

DASHBOARD_PASSWORD=changeme

ENABLE_RECORDING=true
ENABLE_TRANSCRIPTION=true
TRANSCRIPTION_LANGUAGE=en-US
VALIDATE_TWILIO_SIGNATURE=true
